# Feature toggles
ENABLE_GOOGLE_SERVICES=false

# Google Maps Platform (опционально, включайте только если активирован флаг выше)
# Универсальный ключ, если у вас один API-ключ для всех сервисов Google
GOOGLE_API_KEY=
# JavaScript API (браузерное отображение карт Google)
GOOGLE_MAPS_JS_API_KEY=
# Directions API (маршрутизация между точками)
GOOGLE_DIRECTIONS_API_KEY=
# Roads API / SnapToRoads (привязка координат к дорожной сети)
GOOGLE_ROADS_API_KEY=
# Distance Matrix API (поиск ближайших сегментов)
GOOGLE_DISTANCE_MATRIX_API_KEY=
# Geocoding API (адреса по координатам)
GOOGLE_GEOCODING_API_KEY=
# Geolocation API (позиционирование техники)
GOOGLE_GEOLOCATION_API_KEY=
# Places API (поиск объектов вдоль маршрутов)
GOOGLE_PLACES_API_KEY=
# Elevation API (высоты и уклоны)
GOOGLE_ELEVATION_API_KEY=
# Time Zone API (локальное время)
GOOGLE_TIMEZONE_API_KEY=

# Yandex API-ключи
# HTTP Геокодер (https://yandex.ru/dev/maps/geocoder/)
YANDEX_API_KEY=
# JavaScript API 2.1 (https://yandex.ru/dev/maps/jsapi/)
YANDEX_MAPS_JS_API_KEY=
# Геосаджест (подсказки адресов и объектов)
YANDEX_GEOSUGGEST_KEY=
# Локатор (определение координат по сетям)
YANDEX_LOCATOR_API_KEY=
# Static API (статические изображения карт)
YANDEX_STATIC_API_KEY=
# MapKit (мобильные приложения)
YANDEX_MAPKIT_KEY=
# Tiles API (запрос собственных тайлов)
YANDEX_TILES_API_KEY=

# Альтернативные провайдеры маршрутизации
# OpenRouteService (https://openrouteservice.org/dev/#/signup)
ORS_API_KEY=
# Базовый URL OpenRouteService (оставьте по умолчанию для облака ORS)
ORS_BASE_URL=https://api.openrouteservice.org

# OSRM (если разворачиваете локально — http://localhost:5000 и т.п.)
OSRM_BASE_URL=https://router.project-osrm.org

# GraphHopper (https://www.graphhopper.com/dashboard/)
GRAPHHOPPER_API_KEY=
# Базовый URL GraphHopper (cloud или локальная установка)
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1
